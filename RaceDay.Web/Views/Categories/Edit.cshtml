@model RaceDay.Web.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
    ViewData["FormAction"] = "Edit";
    ViewData["Button"] = "Save";
}

<a href="/Categories/Manage/@Model.EventId" class="text-decoration-none">&larr; Back to categories</a>

<div class="mt-3 mb-4">
    <h1 class="mb-1">Edit category</h1>
    <p class="text-muted mb-0">@ViewBag.EventName</p>
</div>

<div class="card">
    <div class="card-body">
        <partial name="_CategoryForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}