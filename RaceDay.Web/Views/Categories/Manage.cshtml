@model RaceDay.Web.Models.ManageCategoriesViewModel
@{
    ViewData["Title"] = "Categories";
    ViewData["FormAction"] = "Add";
    ViewData["Button"] = "Add";
}

<a href="/Organiser/Events" class="text-decoration-none">&larr; Back to my events</a>

<div class="mt-3 mb-4">
    <h1 class="mb-1">Categories</h1>
    <p class="text-muted mb-0">@Model.EventName &ndash; @Model.EventDate.ToString("d MMMM yyyy")</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="mb-3">Add a category</h5>
        <partial name="_CategoryForm" model="Model.NewCategory" />
    </div>
</div>

<h2 class="h4 mb-3">Current categories</h2>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">This event has no categories yet. Add one above so participants can enter.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry fee</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td>@c.Distance.ToString("0.##") km</td>
                            <td>R @c.Fee.ToString("0.00")</td>
                            <td class="text-end">
                                <a href="/Categories/Edit/@c.CategoryId?eventId=@Model.EventId" class="btn btn-outline-primary btn-sm">Edit</a>
                                <form asp-controller="Categories" asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@c.CategoryId" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}