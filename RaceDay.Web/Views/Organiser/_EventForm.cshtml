@model RaceDay.Web.Models.EventFormViewModel

<form asp-controller="Organiser" asp-action="@(ViewData["FormAction"]?.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="BannerUrl" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate" type="date" value="@Model.EventDate.ToString("yyyy-MM-dd")" class="form-control" />
            <span asp-validation-for="EventDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
            <span asp-validation-for="EventType" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance" type="number" step="0.1" min="0.1"
                   value="@Model.Distance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                   class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Banner" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <div class="mb-2">
                <img src="@Model.BannerUrl" alt="Current banner"
                     style="max-width:100%;max-height:160px;object-fit:cover;border-radius:8px;" />
            </div>
        }
        <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
        <div class="form-text">JPG, PNG or WebP, up to 5 MB. Leave empty to keep the current banner.</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(ViewData["Button"]?.ToString())</button>
        <a href="/Organiser/Events" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>