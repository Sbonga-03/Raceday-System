@model List<RaceDay.Web.Models.OrganiserEventInfo>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">My events</h1>
        <p class="text-muted mb-0">Create, edit and delete the events you organise.</p>
    </div>
    <a href="/Organiser/Create" class="btn btn-primary">+ Create event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet. Click <strong>Create event</strong> to start.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th class="text-center">Enrolments</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td style="width:90px;">
                                @if (!string.IsNullOrEmpty(e.BannerUrl))
                                {
                                    <img src="@e.BannerUrl" alt="" style="width:80px;height:50px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <div style="width:80px;height:50px;border-radius:6px;background:linear-gradient(135deg,#0b1f3a,#16335c);"></div>
                                }
                            </td>
                            <td class="fw-semibold">@e.Name</td>
                            <td>@e.EventDate.ToString("d MMM yyyy")</td>
                            <td>@e.Location</td>
                            <td class="text-center"><span class="badge bg-dark">@e.TotalEnrolments</span></td>
                            <td class="text-end">
                                <a href="/Organiser/Edit/@e.EventId" class="btn btn-outline-primary btn-sm">Edit</a>
                                <form asp-controller="Organiser" asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @e.Name? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@e.EventId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}