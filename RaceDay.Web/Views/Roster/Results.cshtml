@model RaceDay.Web.Models.ResultsPageViewModel
@{
    ViewData["Title"] = "Results";
}

<a href="/Roster/Index/@Model.EventId" class="text-decoration-none">&larr; Back to enrolments</a>

<div class="mt-3 mb-4">
    <h1 class="mb-1">Results</h1>
    <p class="text-muted mb-0">@Model.EventName &ndash; @Model.EventDate.ToString("d MMMM yyyy")</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<h2 class="h4 mb-3">Enter results</h2>

@if (!Model.IsConcluded)
{
    <div class="alert alert-info">
        Results can be entered once the event has taken place (@Model.EventDate.ToString("d MMMM yyyy")).
    </div>
}
else if (!Model.Pending.Any())
{
    <div class="alert alert-info">Every entered participant has a result recorded.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            @foreach (var p in Model.Pending)
            {
                <form asp-controller="Roster" asp-action="CaptureResult" method="post" class="border-bottom pb-3 mb-3">
                    <input type="hidden" name="EnrolmentId" value="@p.EnrolmentId" />
                    <input type="hidden" name="EventId" value="@Model.EventId" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <div class="fw-semibold">@p.ParticipantName</div>
                            <div class="text-muted small">@p.CategoryName</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">Finish time</label>
                            <input type="text" name="FinishTime" class="form-control" placeholder="hh:mm:ss"
                                   pattern="\d{1,2}:\d{2}:\d{2}" title="Use the format hh:mm:ss, for example 00:48:32" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1">Position</label>
                            <input type="number" name="Position" min="1" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1">Status</label>
                            <select name="Status" class="form-select">
                                <option value="Finished">Finished</option>
                                <option value="DNF">DNF</option>
                                <option value="DNS">DNS</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Publish</button>
                        </div>
                    </div>
                </form>
            }
            <div class="form-text">DNF = did not finish, DNS = did not start. These need no time or position.</div>
        </div>
    </div>
}

<h2 class="h4 mb-3">Published results</h2>

@if (!Model.Recorded.Any())
{
    <div class="alert alert-info">No results have been published for this event yet.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Position</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Recorded)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @if (r.Position.HasValue)
                                {
                                    @r.Position.Value
                                }
                                else
                                {

                                    <span class="text-muted">&ndash;</span>
                                }
                            </td>
                            <td>@r.ParticipantName</td>
                            <td>@r.CategoryName</td>
                            <td>
                                @if (r.FinishTime.HasValue)
                                {
                                    @r.FinishTime.Value.ToString(@"hh\:mm\:ss")
                                }
                                else
                                {

                                    <span class="text-muted">&ndash;</span>
                                }
                            </td>
                            <td>
                                @if (r.Status == "Finished")
                                {
                                    <span class="status-badge status-finished">Finished</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">@r.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}