@model RaceDay.Web.Models.EventRosterViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<a href="/Organiser/Events" class="text-decoration-none">&larr; Back to my events</a>

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <div>
        <h1 class="mb-1">Enrolments</h1>
        <p class="text-muted mb-0">@Model.EventName &ndash; @Model.EventDate.ToString("d MMMM yyyy")</p>
    </div>
    <a href="/Roster/Results/@Model.EventId" class="btn btn-primary">Enter results</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Enrolments.Any())
{
    <div class="alert alert-info">Nobody has entered this event yet.</div>
}
else
{
    <p class="text-muted">@Model.Enrolments.Count participant(s) entered.</p>
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Entered on</th>
                        <th>Status</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-semibold">@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><span class="status-badge status-@e.Status.ToLower()">@e.Status</span></td>
                            <td>
                                @if (e.HasResult)
                                {
                                    <span class="status-badge status-finished">Recorded</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}