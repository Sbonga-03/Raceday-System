@model RaceDay.Web.Models.EventDetail
@{
    ViewData["Title"] = Model.Name;
    var role = Context.Session.GetString("Role");
    var isPast = Model.EventDate.Date < DateTime.Today;
}

<a href="/" class="text-decoration-none">&larr; Back to events</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}

<div class="card mt-3">
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" alt="@Model.Name banner"
             style="width:100%;max-height:320px;object-fit:cover;border-radius:12px 12px 0 0;" />
    }
    else
    {
        <div class="d-flex align-items-center justify-content-center text-white"
             style="height:220px;border-radius:12px 12px 0 0;background:linear-gradient(135deg,#0b1f3a,#16335c);">
            <span class="display-5">Race<span style="color:#ff5a1f;">Day</span></span>
        </div>
    }

    <div class="card-body">
        <div class="mb-2">
            <span class="badge bg-dark">@Model.EventType</span>
            @if (Model.Distance > 0)
            {
                <span class="badge bg-secondary">@Model.Distance.ToString("0.##") km</span>
            }
            @if (isPast)
            {
                <span class="badge bg-danger">Finished</span>
            }
        </div>
        <h1 class="mb-2">@Model.Name</h1>
        <p class="mb-1"><strong>Date:</strong> @Model.EventDate.ToString("dddd, d MMMM yyyy")</p>
        <p class="mb-3"><strong>Location:</strong> @Model.Location</p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>
</div>

<h2 class="h4 mt-4 mb-3">Categories</h2>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories have been added to this event yet.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry fee</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Distance.ToString("0.##") km</td>
                            <td>R @c.Fee.ToString("0.00")</td>
                            <td class="text-end">
                                @if (isPast)
                                {
                                    <span class="text-muted">Closed</span>
                                }
                                else if (role == "Participant")
                                {
                                    <form asp-controller="Events" asp-action="Enrol" method="post" class="d-inline">
                                        <input type="hidden" name="eventId" value="@Model.EventId" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="btn btn-primary btn-sm">Enter event</button>
                                    </form>
                                }
                                else if (role == "Organiser")
                                {
                                    <span class="text-muted">Participants only</span>
                                }
                                else
                                {
                                    <a href="/Account/Login" class="btn btn-outline-primary btn-sm">Log in to enter</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}